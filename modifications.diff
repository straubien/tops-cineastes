+/* ── Mur de visages ──────────────────────────────────────
+   Mosaïque de portraits en fond du splash. Un index de cinéastes, c'est
+   d'abord un mur de visages : la composition suprématiste (triangle,
+   blocs rouges, bandes) reste posée PAR-DESSUS, intacte.
+
+   Aucun script : chaque tuile porte deux couches d'image (::before et
+   ::after) qui se relaient en fondu croisé. 18 tuiles = 36 visages.
+   Les portraits mesurent 240 px de large et pèsent une vingtaine de
+   ko chacun ; c'est exactement la taille d'une tuile sur un écran de
+   1440 px, donc aucune image n'est chargée pour rien.
+
+   Le réglage système « réduire les animations » est déjà pris en
+   charge par la règle globale en bas de ce fichier : les fondus
+   s'arrêtent alors sur la première couche, qui reste affichée. */
+.splash-mur {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  display: grid;
+  grid-template-columns: repeat(6, 1fr);
+  grid-template-rows: repeat(3, 1fr);
+  /* Filet noir entre les tuiles : le mur se lit comme une planche-contact
+     et non comme une seule photo decoupee. */
+  gap: 2px;
+  overflow: hidden;
+  /* Fond tant que les portraits ne sont pas arrivés : le titre clair
+     reste lisible dès la première image à l'écran. */
+  background: var(--noir);
+}
+.splash-mur > i {
+  position: relative;
+  overflow: hidden;
+  /* Noir et blanc : la plupart des portraits le sont déjà, le filtre
+     met les quelques photos en couleur au même diapason. Il est posé
+     sur la tuile et non sur les deux couches : une seule surface à
+     filtrer au lieu de deux, pendant que le fondu tourne. */
+  filter: grayscale(1) contrast(1.1) brightness(1.02);
+}
+.splash-mur > i::before,
+.splash-mur > i::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  /* Les deux visages d'une tuile sont posés dans --a et --b, plus bas.
+     Passer par des variables plutôt que d'écrire l'image ici permettra,
+     le jour où le mur sera piloté depuis le back-office, de changer un
+     visage en une ligne de JavaScript : une règle CSS ne se modifie pas
+     de l'extérieur, une variable posée sur la tuile, si. */
+  background-size: cover;
+  /* 22 % et non 50 % : sur un portrait, le visage est en haut. */
+  background-position: center 22%;
+  animation: splash-mur-a 32s ease-in-out infinite;
+  /* Chaque tuile part décalée, sinon les 18 visages changeraient
+     ensemble. La valeur vient de « --i », posé dans index.html. */
+  animation-delay: calc(var(--i, 0) * -1.7s);
+}
+.splash-mur > i::before { background-image: var(--a); }
+.splash-mur > i::after  { background-image: var(--b); animation-name: splash-mur-b; }
+
+/* Fondu croisé : un visage tient 14 secondes, puis cède la place à
+   l'autre couche en deux secondes. */
+@keyframes splash-mur-a { 0%, 44% { opacity: 1 } 50%, 94% { opacity: 0 } 100% { opacity: 1 } }
+@keyframes splash-mur-b { 0%, 44% { opacity: 0 } 50%, 94% { opacity: 1 } 100% { opacity: 0 } }
+
+/* Voile sombre — c'est lui qui rend le titre lisible par-dessus les
+   photos. Plus dense au centre, derrière le titre et le bouton. */
+.splash-mur::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background:
+    radial-gradient(ellipse 56% 46% at 50% 50%, rgba(8,8,8,0.86) 0%, rgba(8,8,8,0.58) 55%, rgba(8,8,8,0.38) 100%),
+    linear-gradient(to bottom, rgba(8,8,8,0.46) 0%, rgba(8,8,8,0.06) 34%, rgba(8,8,8,0.06) 64%, rgba(8,8,8,0.56) 100%);
+}
+
+/* Les visages, tuile par tuile. --a est le visage montré d'abord, --b
+   celui qui le remplace. Les tuiles se lisent de gauche à droite puis de
+   haut en bas : 1 à 6 sur la première rangée, 7 à 12 sur la deuxième,
+   13 à 18 sur la troisième (et par colonnes de trois sur mobile).
+   Pour changer un visage, il suffit de remplacer le nom de fichier :
